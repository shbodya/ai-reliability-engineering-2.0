[0.278, "o", "=== Stage 2 — own A2A agent ===\r\n"]
[1.008, "o", "$ source agent-own/.venv/bin/activate && python agent-own/main.py &\r\n"]
[2.053, "o", "\r\n$ curl http://localhost:9000/.well-known/agent-card.json | jq .\r\n"]
[0.037, "o", "{\r\n    \u001b[1m\"name\"\u001b[0m: \u001b[32m\"own-agent\"\u001b[0m,\r\n    \u001b[1m\"description\"\u001b[0m: \u001b[32m\"Summarizes input text + delegates to peer agent via A2A for enrichment.\"\u001b[0m,\r\n    \u001b[1m\"supportedInterfaces\"\u001b[0m: [\r\n        {\r\n            \u001b[1m\"url\"\u001b[0m: \u001b[32m\"http://localhost:9000/a2a/jsonrpc/\"\u001b[0m,\r\n            \u001b[1m\"protocolBinding\"\u001b[0m: \u001b[32m\"JSONRPC\"\u001b[0m\r\n        }\r\n    ],\r\n    \u001b[1m\"version\"\u001b[0m: \u001b[32m\"0.2.0\"\u001b[0m,\r\n    \u001b[1m\"capabilities\"\u001b[0m: {\r\n        \u001b[1m\"streaming\"\u001b[0m: \u001b[1;34mtrue\u001b[0m\r\n    },\r\n    \u001b[1m\"defaultInputModes\"\u001b[0m: [\r\n        \u001b[32m\"text/plain\"\u001b[0m\r\n    ],\r\n    \u001b[1m\"defaultOutputModes\"\u001b[0m: [\r\n        \u001b[32m\"text/plain\"\u001b[0m\r\n    ],\r\n    \u001b[1m\"skills\"\u001b[0m: [\r\n        {\r\n            \u001b[1m\"id\"\u001b[0m: \u001b[32m\"summarize\"\u001b[0m,\r\n            \u001b[1m\"name\"\u001b[0m: \u001b[32m\"Summarize text\"\u001b[0m,\r\n            \u001b[1m\"description\"\u001b[0m: \u001b[32m\"Stats (chars/words/lines) + first sentence + peer enrichment.\"\u001b[0m,\r\n            \u001b[1m\"tags\"\u001b[0m: [\r\n                \u001b[32m\"text\"\u001b[0m,\r\n                \u001b[32m\"summary\"\u001b[0m,\r\n                \u001b[32m\"orchestrato"]
[0.000, "o", "r\"\u001b[0m\r\n            ],\r\n            \u001b[1m\"examples\"\u001b[0m: [\r\n                \u001b[32m\"Summarize: The quick brown fox jumps over the lazy dog.\"\u001b[0m\r\n            ]\r\n        }\r\n    ],\r\n    \u001b[1m\"preferredTransport\"\u001b[0m: \u001b[32m\"JSONRPC\"\u001b[0m,\r\n    \u001b[1m\"protocolVersion\"\u001b[0m: \u001b[32m\"0.3\"\u001b[0m,\r\n    \u001b[1m\"url\"\u001b[0m: \u001b[32m\"http://localhost:9000/a2a/jsonrpc/\"\u001b[0m\r\n}"]
[0.000, "o", "\r\n"]
[2.011, "o", "\r\n$ curl -X POST http://localhost:9000/a2a/jsonrpc/  (SendMessage)\r\n"]
